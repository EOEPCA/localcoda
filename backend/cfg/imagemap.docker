#Use the format <image-ID-in-tutorial> <image-name-plus-tag> <image-hostname> <memory limit> <cpu limit> (spaces are not allowed in any of hte entries)
ubuntu eoepca/localcoda-docker-ubuntu:eoepca-2.1 ubuntu 0 0
ubuntu-4GB eoepca/localcoda-docker-ubuntu:eoepca-2.1 ubuntu 0 0
kubernetes-kubeadm-1node eoepca/localcoda-docker-k3s:eoepca-2.1 controlplane 0 0
kubernetes-kubeadm-1node-4GB eoepca/localcoda-docker-k3s:eoepca-2.1 controlplane 0 0
